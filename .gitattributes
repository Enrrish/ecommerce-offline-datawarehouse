# 统一行尾：仓库内一律存 LF
# Shell 脚本若被检出为 CRLF，Linux 上会报 bad interpreter: /bin/bash^M
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.xlsx binary
*.docx binary
*.pptx binary
*.jar  binary
